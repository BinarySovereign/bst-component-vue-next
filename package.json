{
  "name": "bst-component-vue-next-mono",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "author": "Felix Tang(BinarySovereign)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BinarySovereign/bst-component-vue-next.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "browserslist": [
    "chrome >= 152",
    "edge >= 152",
    "Electron >= 42"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ci:local": "node scripts/ci-local.js",
    "build:private": "node scripts/build-package.js --build private",
    "build:style": "node scripts/build-package.js --build styles",
    "build:vue:next": "node scripts/build-package.js --build vue-next",
    "build:vue:next:pro": "node scripts/build-package.js --build vue-next-pro",
    "build:vue:next:pro:ai": "node scripts/build-package.js --build vue-next-pro-ai",
    "move:main:dist": "node scripts/build-package.js --move main-package",
    "release:notes": "node scripts/release/notes.js",
    "release:pack": "node scripts/release/pack.js",
    "dev:docs": "pnpm -C packages/bst-vue-next/site dev",
    "build:docs": "pnpm -C packages/bst-vue-next/site build",
    "preview:docs": "pnpm -C packages/bst-vue-next/site preview",
    "dev:storybook": "pnpm build:style && pnpm -C packages/bst-vue-next/storybook dev",
    "build:storybook": "pnpm build:style && pnpm -C packages/bst-vue-next/storybook build",
    "typecheck:storybook": "pnpm -C packages/bst-vue-next/storybook typecheck",
    "lint": "pnpm typecheck && eslint ./packages --max-warnings 0 --cache && pnpm lint:style",
    "lint:fix": "eslint ./packages --max-warnings 0 --fix --cache",
    "lint:style": "pnpm -C packages/bst-styles style:lint",
    "lint:style:fix": "pnpm -C packages/bst-styles style:lint:fix",
    "test": "pnpm -C packages/bst-vue-next/test test",
    "test:update": "pnpm -C packages/bst-vue-next/test test:update",
    "test:unit": "pnpm -C packages/bst-vue-next/test test:unit",
    "test:unit-dev": "pnpm -C packages/bst-vue-next/test test:unit-dev",
    "test:unit-gui": "pnpm -C packages/bst-vue-next/test test:unit-gui",
    "test:unit-coverage": "pnpm -C packages/bst-vue-next/test test:unit-coverage",
    "test:snap": "pnpm -C packages/bst-vue-next/test test:snap",
    "test:snap-update": "pnpm -C packages/bst-vue-next/test test:snap-update"
  },
  "devDependencies": {
    "@babel/core": "catalog:build",
    "@babel/helper-module-imports": "catalog:build",
    "@babel/plugin-transform-modules-commonjs": "catalog:build",
    "@babel/plugin-transform-object-assign": "catalog:build",
    "@babel/plugin-transform-runtime": "catalog:build",
    "@babel/preset-env": "catalog:build",
    "@eslint/js": "catalog:lint",
    "@rollup/plugin-babel": "catalog:build",
    "@rollup/plugin-commonjs": "catalog:build",
    "@rollup/plugin-json": "catalog:build",
    "@rollup/plugin-node-resolve": "catalog:build",
    "@rollup/plugin-replace": "catalog:build",
    "@rollup/plugin-typescript": "catalog:build",
    "@rollup/plugin-url": "catalog:build",
    "@types/node": "catalog:types",
    "@typescript-eslint/eslint-plugin": "catalog:lint",
    "@typescript-eslint/parser": "catalog:lint",
    "@vue/babel-plugin-jsx": "catalog:build",
    "@vue/tsconfig": "catalog:lint",
    "autoprefixer": "catalog:build",
    "cross-env": "catalog:build",
    "esbuild": "catalog:build",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-plugin-vue": "catalog:lint",
    "execa": "catalog:build",
    "fs-extra": "catalog:build",
    "glob": "catalog:build",
    "less": "catalog:build",
    "postcss": "catalog:build",
    "postcss-less": "catalog:lint",
    "prettier": "catalog:lint",
    "rimraf": "catalog:build",
    "rollup": "catalog:build",
    "rollup-plugin-esbuild": "catalog:build",
    "rollup-plugin-postcss": "catalog:build",
    "stylelint": "catalog:lint",
    "stylelint-config-standard": "catalog:lint",
    "tsx": "catalog:build",
    "typescript": "catalog:types",
    "vue-eslint-parser": "catalog:lint",
    "vue-tsc": "catalog:types"
  }
}
